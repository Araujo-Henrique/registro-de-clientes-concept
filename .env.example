# Copie para .env (que NAO vai para o git) e troque pelos seus dados.
# Se a senha tiver caracteres especiais (@ : / #), escreva-os codificados (ex.: @ vira %40).
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/concept_client_registry

# Usado so pelos testes. O nome do banco PRECISA terminar em _test: os testes apagam tudo nele.
TEST_DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/concept_client_registry_test
